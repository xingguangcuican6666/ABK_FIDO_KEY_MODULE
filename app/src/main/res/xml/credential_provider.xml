<?xml version="1.0" encoding="utf-8"?>
<!--
  The framework parses <capability> with parser.getAttributeValue(null, "name")
  (CredentialProviderInfoFactory), i.e. a no-namespace `name` attribute — NOT
  `android:name`. Using the android: prefix makes the capability list parse
  empty, and the provider is then rejected from every ceremony with
  "Service does not have the required capabilities". The type string must also
  be the androidx one the request carries.
-->
<credential-provider>
    <capabilities>
        <capability name="androidx.credentials.TYPE_PUBLIC_KEY_CREDENTIAL" />
    </capabilities>
</credential-provider>
